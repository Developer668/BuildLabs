{
  "name": "@buildlabs/dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "COPILOTKIT_TELEMETRY_DISABLED=true next build",
    "dev": "COPILOTKIT_TELEMETRY_DISABLED=true next dev --hostname 127.0.0.1 --port 3200",
    "lint": "eslint . --max-warnings=0",
    "start": "COPILOTKIT_TELEMETRY_DISABLED=true next start --hostname 127.0.0.1 --port 3200",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "0.0.57",
    "@copilotkit/react-core": "1.63.2",
    "@copilotkit/runtime": "1.63.2",
    "@elevenlabs/client": "^1.15.2",
    "lucide-react": "0.468.0",
    "next": "16.2.11",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "rxjs": "7.8.2",
    "sharp": "0.35.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.2.11",
    "jsdom": "29.1.1",
    "tailwindcss": "4.2.1",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
